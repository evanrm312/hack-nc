# Copy to .env for local development. Never commit .env.

# Flask
SECRET_KEY=change-me
FLASK_APP=server.app

# Database. Default is a local SQLite file; use Supabase/Postgres for the deployed app.
DATABASE_URL=sqlite:///var/dev.sqlite3
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# PostgreSQL integration tests require a separate isolated database ending in _test.
TEST_DATABASE_URL=
# TEST_DATABASE_URL=postgresql+psycopg://test_user:PASSWORD@localhost:5432/campus_current_test
APP_ENV=development

# Auth. "sandbox" = isolated labeled seeded identities (local dev/tests only).
# "supabase" = real email confirmation via Supabase Auth (deployed app).
AUTH_MODE=sandbox
SANDBOX_USERS=alice@unc.edu,bob@unc.edu
ALLOWED_EMAIL_DOMAIN=unc.edu
# Temporary testing only: false also requires disabling Supabase Confirm email.
# New test accounts are labeled unverified and blocked when this is re-enabled.
REQUIRE_EMAIL_CONFIRMATION=true

# Supabase (required when AUTH_MODE=supabase or STORAGE_BACKEND=supabase).
# URL and anon key are public and rendered to the browser. The service-role
# key is backend-only and must never be exposed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_HTTP_TIMEOUT_SECONDS=5

# Gemini (backend only; Person 2).
GEMINI_API_KEY=

# Storage. Local writes under UPLOAD_DIR. Supabase uses separate existing buckets.
# Create public-listings as PUBLIC and private-evidence as PRIVATE in Supabase.
# Only Flask uses the service-role key; never expose private evidence URLs.
STORAGE_BACKEND=local
UPLOAD_DIR=var/uploads
MAX_UPLOAD_BYTES=5242880
SUPABASE_PUBLIC_BUCKET=public-listings
SUPABASE_PRIVATE_BUCKET=private-evidence
STORAGE_HTTP_TIMEOUT_SECONDS=10
