# Copy outside version control as .env.production; supply secrets through your host.
APP_ENV=production
AUTH_MODE=supabase
STORAGE_BACKEND=supabase
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@SESSION_POOLER:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_BROWSER_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_KEY
SUPABASE_PUBLIC_BUCKET=public-listings
SUPABASE_PRIVATE_BUCKET=private-evidence
GEMINI_API_KEY=REPLACE_WITH_SERVER_ONLY_KEY
DB_POOL_SIZE=4
WEB_WORKERS=2
NORMALIZE_RATE_PER_MINUTE=10
WRITE_RATE_PER_MINUTE=60
TRUSTED_PROXY_HOPS=0
FORWARDED_ALLOW_IPS=127.0.0.1
